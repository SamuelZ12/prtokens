{
  "name": "prtokens",
  "version": "0.4.1",
  "description": "Attribute coding-agent token usage to GitHub pull requests.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": { ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" } },
  "bin": { "prtokens": "dist/cli.js" },
  "files": ["dist", "README.md", "CHANGELOG.md", "LICENSE"],
  "engines": { "node": ">=22.13" },
  "repository": { "type": "git", "url": "git+https://github.com/SamuelZ12/prtokens.git" },
  "homepage": "https://github.com/SamuelZ12/prtokens#readme",
  "bugs": { "url": "https://github.com/SamuelZ12/prtokens/issues" },
  "author": "Samuel Zhang",
  "keywords": ["coding-agent", "claude-code", "codex", "opencode", "tokens", "github", "pull-request", "cli"],
  "scripts": { "build": "tsc -p tsconfig.json && node -e \"const fs = require('node:fs'); fs.mkdirSync('dist/pricing', { recursive: true }); fs.copyFileSync('src/pricing/litellm-snapshot.json', 'dist/pricing/litellm-snapshot.json');\"", "test": "vitest run", "test:watch": "vitest", "typecheck": "tsc -p tsconfig.json --noEmit", "update-pricing": "node scripts/update-pricing-snapshot.mjs", "prepublishOnly": "npm test && npm run build" },
  "devDependencies": { "@types/node": "^22.0.0", "typescript": "^5.4.0", "vitest": "^1.6.0" },
  "license": "MIT"
}
